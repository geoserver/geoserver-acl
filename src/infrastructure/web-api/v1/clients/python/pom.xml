<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.geoserver.acl.infrastructure</groupId>
    <artifactId>gs-acl-webapi-v1-clients-parent</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>gs-acl-webapi-v1-python-client</artifactId>
  <description>Generated Python Client: For consumption by Python clients</description>
  <dependencies></dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <?m2e ignore?>
            <id>python-package-version</id>
            <goals>
              <goal>regex-property</goal>
            </goals>
            <phase>initialize</phase>
            <configuration>
              <!-- Maven SNAPSHOT versions are not valid PEP 440; map to a .dev0 release -->
              <name>python.package.version</name>
              <value>${revision}</value>
              <regex>-SNAPSHOT$</regex>
              <replacement>.dev0</replacement>
              <failIfNoMatch>false</failIfNoMatch>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <?m2e ignore?>
            <id>generate-python-client</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <skip>${openapi-codegen-skip}</skip>
              <inputSpec>${project.basedir}/../../../spec/src/main/resources/geoserver-acl-web-api-spec-v1.yaml</inputSpec>
              <!-- see https://openapi-generator.tech/docs/generators/python -->
              <generatorName>python</generatorName>
              <!-- This is the Python import name. It must use underscores. -->
              <packageName>geoserver_acl_client</packageName>
              <!-- Rendered into the Repository URL of the generated pyproject.toml -->
              <gitUserId>geoserver</gitUserId>
              <gitRepoId>geoserver-acl</gitRepoId>
              <configOptions>
                <!-- The PyPI distribution name; PEP 503 also normalizes the
                     underscore package name to geoserver-acl-client -->
                <projectName>geoserver-acl-client</projectName>
                <!-- Synchronous client; asyncio/httpx flavors were ruled out
                     to keep plain scripts and requirements.txt consumers simple -->
                <library>urllib3</library>
                <packageVersion>${python.package.version}</packageVersion>
                <generateSourceCodeOnly>false</generateSourceCodeOnly>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
